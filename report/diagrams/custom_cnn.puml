@startuml custom_cnn_architecture
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 11
skinparam roundcorner 8

title Custom CNN Architecture (678,085 Parameters, Trained from Scratch)

rectangle "Input Image\n224 x 224 x 3" as in #f9f9f9

package "Convolutional Feature Extractor (4 Stages)" {
  rectangle "Block 1\n2x [Conv2D(32, 3x3) + BN + ReLU]\nOutput: 112 x 112 x 32 (MaxPool 2x2)" as b1 #ffffff
  rectangle "Block 2\n2x [Conv2D(64, 3x3) + BN + ReLU]\nOutput: 56 x 56 x 64 (MaxPool 2x2)" as b2 #ffffff
  rectangle "Block 3\n2x [Conv2D(128, 3x3) + BN + ReLU]\nOutput: 28 x 28 x 128 (MaxPool 2x2)" as b3 #ffffff
  rectangle "Block 4\n1x [Conv2D(256, 3x3) + BN + ReLU]\nOutput: 14 x 14 x 256 (MaxPool 2x2)" as b4 #ffffff
}

package "Regularized Classifier Head (99.5% Parameter Suppression)" {
  rectangle "GlobalAveragePooling2D\nSpatially averages 14x14 -> 256-dim vector" as gap #ffffff
  rectangle "BatchNormalization + Dropout(0.4)\nInternal covariate centering" as drop1 #ffffff
  rectangle "Dense(256, ReLU) + BatchNorm\nNon-linear classification manifold" as fc1 #ffffff
  rectangle "Dropout(0.3)\nCo-adaptation prevention" as drop2 #ffffff
  rectangle "Dense(101, Softmax)\nPosterior class probabilities P(Y=k|x)" as out #f9f9f9
}

in --> b1 : 224x224x3
b1 --> b2 : 112x112x32
b2 --> b3 : 56x56x64
b3 --> b4 : 28x28x128
b4 --> gap : 14x14x256
gap --> drop1 : 256
drop1 --> fc1 : 256
fc1 --> drop2 : 256
drop2 --> out : 101 Classes
@enduml
